# AD-721e: skeletal animation clips (operator-fetched via scripts/animations-fetch.ps1).
data/avatars/animations/

# AD-720: attachments dir is shipped (with .gitkeep), but image blobs are not.
!data/attachments/
data/attachments/*
!data/attachments/.gitkeep

