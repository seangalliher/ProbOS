# Dev gate/build log captures. CONVENTION (2026-06-27): write these to logs/
# (e.g. logs/adNNN_gate.txt), NOT the repo root - see prompts/BUILDER-EXECUTION-PLAN.md.
# logs/ is the canonical location (ignored except .gitkeep). The root-anchored
# patterns below stay as a back-compat safety net so a stray root capture is
# still never committed. All regenerable; never committed.
/logs/*
!/logs/.gitkeep
/*_gate.txt
/*_blast.txt
/*_blast2.txt
/*_triage.txt
/*_build.txt
/*_vitest.txt
/*_baseline.txt
/ad[0-9]*_*.txt
/*_serial.txt
/*_iso.txt
/*_iso2.txt
/*_e2e.txt
/*_pytest.txt
/*_targeted.txt
/*_focus.txt
/*_devserver.txt
/*_row.txt

# Playwright MCP browser-tool session artifacts
.playwright-mcp/